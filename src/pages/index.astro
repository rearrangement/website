---
import "../../public/sass/style.sass";

import DiscordLogo from "../components/DiscordLogo.astro";
import EmailLogo from "../components/EmailLogo.astro";
import GithubLogo from "../components/GithubLogo.astro";
import MonkeyTypeLogo from "../components/MonkeyTypeLogo.astro";
import SpotifyLogo from "../components/SpotifyLogo.astro";
import SteamLogo from "../components/SteamLogo.astro";
import PersonLogo from "../components/PersonLogo.astro";
---

<html lang="en-us">
    <head>
		<meta charset="utf-8" />
		<title>dylan : shxrk.dev</title>
	
		<meta property="og:title" content="dylan : shxrk.dev"/>
		<meta property="og:description" content="dylan's socials and about"/>
		<meta property="og:url" content="https://shxrk.dev"/>
		<meta property="og:type" content="website"/>
	</head>

    <body class="bio">
        <div class="card">
			<div class="title">
				<span class="person"><PersonLogo /></span>
				<div class="name">
					&nbsp;&nbsp; Dylan
					<div class="description">
					&nbsp;&nbsp;&nbsp;&nbsp; <span class="typed"></span>
					</div>
				</div>
			<div class="embeds">

			</div>
			<div class="socials">

			</div>
        </div>
    </body>

	<script is:inline src="/ts/card.js"></script>
	<script is:inline src="/ts/typed.js"></script>

	<script> 
		document.addEventListener("DOMContentLoaded", function() {
			var typed = new Typed(".typed", {
				strings: ["sometimes smart", "professional useless git committer", "never finishes projects", "always listening to music", "<3 vibe coding", "13 years old"],
				typeSpeed: 70,
				backSpeed: 50,
				loop: true
			});
		});
	</script>
</html>