---
import "../../public/sass/style.sass";

import DiscordLogo from "../components/logos/DiscordLogo.astro";
import EmailLogo from "../components/logos/EmailLogo.astro";
import GithubLogo from "../components/logos/GithubLogo.astro";
import MonkeyTypeLogo from "../components/logos/MonkeyTypeLogo.astro";
import SpotifyLogo from "../components/logos/SpotifyLogo.astro";
import SteamLogo from "../components/logos/SteamLogo.astro";
import PersonLogo from "../components/logos/PersonLogo.astro";
import DiscordPresence from "../components/DiscordPresence.astro";
---

<html lang="en-us">
    <head>
		<meta charset="utf-8" />
		<title>dylan : shxrk.dev</title>
	
		<meta property="og:title" content="dylan : shxrk.dev"/>
		<meta property="og:description" content="dylan's socials and about"/>
		<meta property="og:url" content="https://shxrk.dev"/>
		<meta property="og:type" content="website"/>
	</head>

    <body class="bio">
        <div class="card">
			<div class="title">
				<span class="person"><PersonLogo /></span>
				<div class="name">
					&nbsp;&nbsp; Dylan
					<div class="description">
					&nbsp;&nbsp;&nbsp;&nbsp; <span class="typed"></span>
				</div>
			</div>
        </div>

		<br>

		<div class="presence">
			<DiscordPresence uid="1259305738183114812" />
		</div>

		<br>

		<div class="socials">
				<DiscordLogo link="https://discord.com/users/1259305738183114812" />
        		<GithubLogo link="https://github.com/rearrangement" />
        		<EmailLogo address="hi@shxrk.dev" /> <!-- You only need to type the email address here, don't worry about the mailto: part -->
        		<SteamLogo link="https://steamcommunity.com/id/rearrangements/" />
        		<SpotifyLogo link="https://open.spotify.com/user/ip24s6xdgak5k5rjnuqc59qo4" />
        		<MonkeyTypeLogo link="https://monkeytype.com/profile/dylnn" />
			</div>
    </body>

	<script is:inline src="/ts/card.js"></script>
	<script is:inline src="/ts/libs/typed.js"></script>

	<script> 
		document.addEventListener("DOMContentLoaded", function() {
			var typed = new Typed(".typed", {
				strings: ["sometimes smart", "professional useless git committer", "never finishes projects", "always listening to music", "i love vibe coding", "13 years old"],
				typeSpeed: 70,
				backSpeed: 50,
				loop: true
			});
		});
	</script>
</html>