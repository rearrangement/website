# Copy to `.env` and fill in. Everything here is optional — the matching
# widget just renders a placeholder when its value is missing.
#
# `.env` is gitignored. Values here are read server-side only and are never
# bundled into the client JS, so they don't end up in view-source.
# Do NOT move any of these into src/lib/config.ts — that file is imported by
# a component, which means all of it ships to the browser in plaintext.

# Last.fm API key, for top artists + recent scrobbles.
# Create one at https://www.last.fm/api/account/create (instant, free).
# You only need the "API key" it gives you — not the shared secret.
# Then scrobble Spotify to Last.fm: last.fm Settings > Applications > Spotify.
LASTFM_API_KEY=

# Optional. Raises the GitHub REST rate limit from 60/hr to 5000/hr per IP.
# A classic token with NO scopes is enough — this only reads public data.
GITHUB_TOKEN=

# Coordinates for the weather widget. Leave blank to hide weather entirely.
#
# Round these — do not paste your exact house coords. Decimal places on a
# latitude are worth roughly:
#   2dp = ~1.1 km   <- plenty for weather, recommended
#   3dp = ~110 m    <- your street
#   4dp = ~11 m     <- your building
# Weather does not vary at 110 m, so 2dp costs you nothing and pins you to a
# neighbourhood rather than a doorstep. Rounding 40.71283 -> 40.71 is enough.
#
# Only the temperature and a text description are ever sent to the browser —
# the coordinates themselves stay on the server.
WEATHER_LAT=
WEATHER_LON=

# Dev preview only. Set to "true" to render the WakaTime card with placeholder
# data — useful before a new account has any history. Leave blank/unset in
# production. (It's gitignored here anyway, so it won't ship by accident.)
WAKATIME_MOCK=
